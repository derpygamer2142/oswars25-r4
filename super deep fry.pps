{"blockDat":{},"dynamicDat":{"dynamic_variables":[],"dynamic_myblocks":[]},"glsl":"#version 300 es\n\n//This is the default shader for the shader editor!\n//These functions are here and are written for the GLSL 3.0 specification.\n//You can revert it to GLSL 1.0 by removing the version number\n\nprecision highp float;\n// defualt precision for floats\n\n//our output for color\nout highp vec4 fragColor;\n//Base Variables\nattribute highp vec4 a_position;\nattribute highp vec4 a_color;\nattribute highp vec2 a_texCoord;\n\nvarying highp vec4 v_color;\nvarying highp vec2 v_texCoord;\n\nvarying highp float v_depth;\nuniform highp float u_timer;\nuniform highp mat4 u_transform;\n\n//Pen+ Textures\nuniform mediump vec2 u_res;\n\n//Base functions\n\n//Some missing math functions\nhighp float log10(highp float a) {\n  return log(a)/log(10.0);\n}\n\nhighp float eulernum(highp float a) {\n  return 2.718 * a;\n}\n\n//Psuedorandomness\nhighp vec4 pcg4d(highp vec4 v)\n{\n  v = v * 1664525.0 + 1013904223.0;\n  \n  v.x += v.y*v.w;\n  v.y += v.z*v.x;\n  v.z += v.x*v.y;\n  v.w += v.y*v.z;\n  \n  v.x += v.z*v.w;\n  v.y += v.y*v.x;\n  v.z += v.x*v.w;\n  v.w += v.y*v.x;\n  \n  return vec4(v);\n}\n\nhighp vec4 daveRandomRange(highp float lowR, highp float highR)\n{\n  lowp float r = (gl_FragCoord.x * 50.25313532) + (gl_FragCoord.y * 21.5453) + u_timer;\n  highp float randomizer = r*r/u_timer/5398932.234523;\n  return clamp(vec4(\n  fract(sin(mod(randomizer*(91.3458), 1440.0)) * 47453.5453),\n  fract(sin(mod(randomizer*(80.3458), 1440.0)) * 48456.5453),\n  fract(sin(mod(randomizer*(95.3458), 1440.0)) * 42457.5453),\n  fract(sin(mod(randomizer*(85.3458), 1440.0)) * 47553.5453)\n  ), lowR, highR);\n}\n\nhighp vec4 HSVToRGB(highp float hue, highp float saturation, highp float value, highp float a) {\n  highp float huePrime = mod(hue,360.0);\n  highp float c = (value/100.0) * (saturation/100.0);\n  highp float x = c * (1.0 - abs(mod(huePrime/60.0, 2.0) - 1.0));\n  highp float m = (value/100.0) - c;\n  highp float r = 0.0;\n  highp float g = 0.0;\n  highp float b = 0.0;\n  \n  if (huePrime >= 0.0 && huePrime < 60.0) {\n      r = c;\n      g = x;\n      b = 0.0;\n  } else if (huePrime >= 60.0 && huePrime < 120.0) {\n      r = x;\n      g = c;\n      b = 0.0;\n  } else if (huePrime >= 120.0 && huePrime < 180.0) {\n      r = 0.0;\n      g = c;\n      b = x;\n  } else if (huePrime >= 180.0 && huePrime < 240.0) {\n      r = 0.0;\n      g = x;\n      b = c;\n  } else if (huePrime >= 240.0 && huePrime < 300.0) {\n      r = x;\n      g = 0.0;\n      b = c;\n  } else if (huePrime >= 300.0 && huePrime < 360.0) {\n      r = c;\n      g = 0.0;\n      b = x;\n  }\n  r += m;\n  g += m;\n  b += m;\n  return vec4(r, g, b, a);\n}\n\nhighp vec4 HSVToRGB(highp vec4 colorInput) {\n  return HSVToRGB(colorInput.x, colorInput.y, colorInput.z, colorInput.w);\n}\n\nhighp vec4 RGBToHSV(highp float r, highp float g, highp float b, highp float a) {\n  //Get the brightest and darkest channels\n  highp float CMax = r;\n  if (g > CMax) { CMax = g; }\n  if (b > CMax) { CMax = b; }\n\n  highp float CMin = r;\n  if (g < CMin) { CMin = g; }\n  if (b < CMin) { CMin = b; }\n\n  highp float Delta = CMax - CMin;\n\n  highp float H = 0.0;\n\n  //Multiply and get the Hue\n  if (CMax == r) {\n      H = 60.0 * mod(((g - b) / Delta), 6.0);\n  }\n  if (CMax == g) {\n      H = 60.0 * ((b - r) / Delta + 2.0);\n  }\n  if (CMax == b) {\n      H = 60.0 * ((r - g) / Delta + 4.0);\n  }\n\n  //Set the saturation\n  highp float S = 0.0;\n  if (CMax != 0.0) {\n      S = Delta / CMax;\n  }\n    \n  return vec4(H, S * 100.0, CMax * 100.0, a);\n}\n\nhighp vec4 RGBToHSV(highp vec4 colorInput) {\n  return RGBToHSV(colorInput.x, colorInput.y, colorInput.z, colorInput.w);\n}\n\nhighp vec4 rotation(highp vec4 invec4) {\n  return vec4(\n    (invec4.y) * u_transform[1][0] + (invec4.x) * u_transform[1][1],\n    (invec4.y) * u_transform[1][1] - (invec4.x) * u_transform[1][0],\n    invec4.zw\n  );\n}\n\nuniform highp sampler2D u_skin;\n// from https://www.shadertoy.com/view/4djSRW\nhighp vec2 hash22(highp vec2 p)\n{\n\thighp vec3 p3 = fract(vec3(p.xyx) * vec3(.1031, .1030, .0973));\n  p3 += dot(p3, p3.yzx+33.33);\n  return fract((p3.xx+p3.yz)*p3.zy);\n}\n// ditto\nfloat hash11(float p)\n{\n    p = fract(p * .1031);\n    p *= p + 33.33;\n    p *= p + p;\n    return fract(p);\n}\n\n\n\nhighp vec4 saturate(highp vec4 col, highp float saturation) {\n  vec4 hsv = RGBToHSV(col);\n\n  return HSVToRGB(hsv * vec4(1.0, saturation, 2.0, 1.0));\n}\n\nhighp vec4 deepFry(highp vec2 pos) {\n  highp vec4 texsample = texture(u_skin, pos/u_res);\n  highp vec4 col = texsample;\n\n  highp float luminance = dot(vec3(.213, .715, .072), col.xyz);\n  if (luminance > .4) pos += hash22(pos)*5.0/luminance;\n\n  col = HSVToRGB(hash11(pos.x)*360.0, 100.0, 70.0, 1.0); //saturate(floor(col*255.0/75.0)*75.0/255.0, 2.);\n  //col = mix(col, texsample, .5);\n\n  return col;\n}\n\nconst highp mat3 kernelX = mat3(-1., -2., -1., 0., 0., 0., 1., 2., 1.);\nconst highp mat3 kernelY = mat3(-1., 0., 1., -2., 0., 2., -1, 0., 1.);\n\n//Fragment Shader\nvoid fragment() {\n  gl_FragColor = v_color;\n\n  /*gl_FragColor = texture(u_skin, gl_FragCoord.xy/u_res); \n\n  highp float luminance = dot(vec3(.213, .715, .072), gl_FragColor.xyz);\n  vec2 pos = gl_FragCoord.xy;\n  if (luminance > .4) pos += hash22(gl_FragCoord.xy)*5.0/luminance;\n  gl_FragColor = texture(u_skin, pos/u_res);\n\n  gl_FragColor = saturate(floor(gl_FragColor*255.0/75.0)*75.0/255.0);*/\n\n  vec4 col = vec4(0.0);\n\n  for (float x = -1.0; x < 2.0; x += 1.0) {\n    for (float y = -1.0; y < 2.0; y += 1.0) {\n      vec4 tex = texture(u_skin, (gl_FragCoord.xy+vec2(x,y))/u_res);\n\n      col += tex*kernelX[uint(x+1.0)][uint(y+1.0)];     \n    }\n  }\n\n  highp float len = length(col.xy);\n\n  if (len > 0.4) col = deepFry(gl_FragCoord.xy);\n  else col = saturate(texture(u_skin, gl_FragCoord.xy/u_res), .4);\n\n  gl_FragColor = col;\n}","isText":true,"savedVarState":{"u_skin":"Pepper"}}